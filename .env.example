# Copy to .env (gitignored). Alpaca PAPER keys — never commit live keys.
ALPACA_KEY=your_paper_key
ALPACA_SECRET=your_paper_secret
# Paper trading base. Any non-paper base is refused unless ALLOW_LIVE=1 (fail-closed).
ALPACA_BASE=https://paper-api.alpaca.markets
# Crypto market-data websocket (verify endpoint against current Alpaca docs).
ALPACA_DATA_WS=wss://stream.data.alpaca.markets/v1beta3/crypto/us
ANTHROPIC_API_KEY=your_anthropic_key
# Set to 1 ONLY to allow a non-paper (live) base. Leave empty to refuse live.
ALLOW_LIVE=
